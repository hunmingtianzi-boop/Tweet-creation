{
  "schema_version": 2,
  "kind": "org-wechat-runtime-adapter",
  "harness": "codex-desktop",
  "truth_boundary": "routing-only; the host tool trace is required for live proof",
  "capabilities": {
    "image.generate.opaque": {
      "route": "tool",
      "requires": ["image_gen__imagegen"]
    },
    "image.generate.rgba": {
      "route": "chatgpt-web",
      "requires": [
        "codex-with-chatgpt",
        "browser:control-in-app-browser",
        "mcp__node_repl__js"
      ],
      "provider_skill": {
        "id": "chatgpt-web-image-route",
        "required_status": "loaded",
        "contract": "chatgpt-web-image-route-v1"
      },
      "output_contract": "subject-cutout-rgba8-v1",
      "processor": "scripts/prepare_micro_cutout.py",
      "acquisition_preference": "native-alpha-first-controlled-key-fallback-only",
      "preferred_processor_arg": "--require-native-alpha",
      "fallback_processor_arg": "--key-color",
      "migration_probe_contract": "neutral-rgba-route-probe-v1",
      "generation_route_id": "chatgpt-web-image-route-v1",
      "live_proof": "migration-neutral-probe-plus-independent-first-official-asset-lineage"
    },
    "image.inspect": {
      "route": "tool",
      "requires": ["view_image"]
    },
    "chatgpt.session": {
      "route": "skill+browser",
      "requires": ["codex-with-chatgpt"],
      "status": "requires-current-session-doctor-and-login-probe"
    },
    "ardot.create": {
      "route": "mcp",
      "requires": [
        "mcp__ardot_remote__create_design",
        "mcp__ardot_remote__create_new_page"
      ]
    },
    "ardot.read": {
      "route": "mcp",
      "requires": [
        "mcp__ardot_remote__fetch_file_info",
        "mcp__ardot_remote__fetch_editor_state",
        "mcp__ardot_remote__batch_read"
      ]
    },
    "ardot.write": {
      "route": "mcp",
      "requires": ["mcp__ardot_remote__batch_edit"]
    },
    "ardot.export": {
      "route": "mcp",
      "requires": [
        "mcp__ardot_remote__capture_screenshot",
        "mcp__ardot_remote__export_nodes"
      ]
    },
    "browser.control": {
      "route": "skill+tool",
      "requires": [
        "browser:control-in-app-browser",
        "mcp__node_repl__js"
      ]
    },
    "computer.use": {
      "route": "skill+tool",
      "requires": [
        "computer-use:computer-use",
        "mcp__node_repl__js"
      ]
    },
    "wechat.draft": {
      "route": "browser",
      "status": "requires-live-login-and-account-probe",
      "requires": [
        "browser:control-in-app-browser",
        "mcp__node_repl__js"
      ],
      "api_provider": "not-bound"
    },
    "host.receipt.attest": {
      "route": "unavailable",
      "availability": "unavailable",
      "requires": [],
      "reason": "Codex Desktop has no callable host receipt signer in this runtime; current-session-draft remains available, while portable-signed-audit and formal publish/group-send remain blocked",
      "trust_boundary": "host-owned-private-key-and-protected-trust-store"
    },
    "secret.resolve": {
      "route": "environment",
      "requires": [
        "PROVENANCE_WATERMARK_KEY",
        "PROVENANCE_WATERMARK_PRIVATE_ROOT"
      ]
    }
  }
}
